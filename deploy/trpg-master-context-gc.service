[Unit]
Description=Reference-aware TRPG Master model-context maintenance
After=postgresql.service

[Service]
Type=oneshot
User=trpgdeploy
Group=trpgdeploy
UMask=0077
EnvironmentFile=/etc/trpg-master/trpg-master.env
Environment=TRPG_RUNTIME_ROOT=/var/lib/trpg-master
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/trpg-master/current/.venv/bin/python /opt/trpg-master/current/tools/maintain_context_events.py
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
