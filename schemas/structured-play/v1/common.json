{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trpg-master.local/schemas/structured-play/v1/common.json",
  "title": "结构化操作协议 v1：公共定义",
  "description": "action_request / free_roll_request / check_response / command_request / events 共用的原语。字段变更必须同步更新本文件、前端 protocol/structured.ts 与 fixtures。",
  "$defs": {
    "id_string": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "description": "稳定对象 ID。不透明字符串；新模式只接受服务端授权的稳定 ID。"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "description": "世界已提交版本号（WorldState.revision）。"
    },
    "target": {
      "description": "动作目标：稳定 ID 或未解析文本。未解析目标不直接执行对应命令。",
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "id"],
          "additionalProperties": false,
          "properties": {
            "kind": {"enum": ["npc", "investigator", "scene_object"]},
            "id": {"$ref": "#/$defs/id_string"}
          }
        },
        {
          "type": "object",
          "required": ["kind", "text"],
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "unresolved"},
            "text": {"type": "string", "minLength": 1, "maxLength": 160}
          }
        }
      ]
    },
    "audience": {
      "description": "接收范围。服务端在投递前据此过滤；history/导出/素材出口使用同一过滤。",
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {"kind": {"const": "public"}}
        },
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {"kind": {"const": "keeper"}}
        },
        {
          "type": "object",
          "required": ["kind", "investigator_ids"],
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "investigators"},
            "investigator_ids": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/id_string"}
            }
          }
        }
      ]
    },
    "speaker": {
      "description": "结构身份发言。普通玩家只能以自己控制的调查员身份发言；keeper/npc/system 身份仅主持命令可用。",
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["keeper", "npc", "investigator", "system"]},
        "id": {"$ref": "#/$defs/id_string"}
      }
    },
    "domain_outcome": {
      "type": "string",
      "enum": ["success", "failure", "not_executed"],
      "description": "领域结果。与行动状态机（completed 等）分层：completed 不代表行动成功。"
    },
    "error_code": {
      "type": "string",
      "description": "错误码。前 13 个与前端 REQUEST_ERROR_TEXTS 已知集一致；后端新增码前端用 message 兜底。",
      "enum": [
        "revision_conflict",
        "duplicate_request_conflict",
        "unknown_target",
        "stale_target",
        "unsupported_protocol",
        "not_authorized",
        "not_actor",
        "check_not_pending",
        "check_already_resolved",
        "invalid_action",
        "rate_limited",
        "keeper_unavailable",
        "request_not_found",
        "unknown_world",
        "target_unresolved",
        "object_not_found",
        "object_not_held",
        "presentation_requires_item",
        "presentation_requires_asset",
        "check_conditions_changed",
        "controller_epoch_stale",
        "keeper_required",
        "not_investigator_controller",
        "profile_mismatch",
        "mode_unavailable",
        "budget_exceeded",
        "commit_failed",
        "internal_error",
        "thread_not_found"
      ]
    },
    "dice_spec": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^(\\d{1,2})d(\\d{1,3})([+-]\\d{1,3})?$",
      "description": "受限掷骰表达式 NdM 或 NdM±K。服务端另强制：个数 1-10、面数 2-100、|修正| ≤ 999、按请求频率限流。"
    }
  }
}
