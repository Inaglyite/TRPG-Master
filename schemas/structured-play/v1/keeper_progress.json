{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trpg-master.local/schemas/structured-play/v1/keeper_progress.json",
  "type": "object", "additionalProperties": false, "required": ["clues", "clocks"],
  "properties": {
    "holdings": {"type": "object", "additionalProperties": false, "required": ["holders", "items"], "properties": {
      "holders": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["kind", "id", "name"], "properties": {
        "kind": {"enum": ["investigator", "npc", "scene"]}, "id": {"type": "string", "minLength": 1, "maxLength": 160}, "name": {"type": "string"}
      }}},
      "items": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "label", "quantity", "holder"], "properties": {
        "id": {"type": "string"}, "label": {"type": "string"}, "quantity": {"type": "integer", "minimum": 1},
        "holder": {"type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": {"kind": {"enum": ["investigator", "npc", "scene"]}, "id": {"type": "string", "minLength": 1, "maxLength": 160}}}
      }}}
    }},
    "clues": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "category", "text", "discovered", "granted_item", "item_id", "holder_id", "related_scenes", "rules"],
      "properties": {
        "id": {"type": "string"}, "category": {"type": "string"}, "text": {"type": "string"},
        "discovered": {"type": "boolean"}, "granted_item": {"type": "string"},
        "item_id": {"type": "string"}, "holder_id": {"type": "string"},
        "related_scenes": {"type": "array", "items": {"type": "string"}},
        "rules": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["index", "intent", "skill", "difficulty", "requires_success", "approach", "sanity_note", "conditions"],
          "properties": {
            "index": {"type": "integer", "minimum": 0}, "intent": {"type": "string"},
            "skill": {"type": "string"}, "difficulty": {"type": "string"},
            "requires_success": {"type": "boolean"}, "approach": {"type": "string"}, "sanity_note": {"type": "string"},
            "conditions": {"type": "array", "items": {"type": "object", "additionalProperties": false,
              "required": ["flag_id", "expected_text", "current_text", "satisfied"],
              "properties": {"flag_id": {"type": "string"}, "expected_text": {"type": "string"}, "current_text": {"type": "string"}, "satisfied": {"type": "boolean"}}}}
          }}}
      }}},
    "clocks": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "title", "value", "max", "level", "next_level", "advance_when"],
      "properties": {
        "id": {"type": "string"}, "title": {"type": "string"},
        "value": {"type": ["integer", "null"]}, "max": {"type": ["integer", "null"], "minimum": 0},
        "level": {"type": "string"}, "next_level": {"type": "string"},
        "advance_when": {"type": "array", "items": {"type": "string"}}
      }}}
  }
}
